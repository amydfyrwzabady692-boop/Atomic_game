# ---------------------------------------------------------------- جنگو
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=example.com,localhost
# برای پنل ادمین و مینی‌اپ پشت HTTPS
CSRF_TRUSTED_ORIGINS=https://example.com

# ---------------------------------------------------------------- دیتابیس و Redis
# در docker-compose این دو مقدار خودکار تنظیم می‌شوند
DATABASE_URL=postgres://gamebot:gamebot@db:5432/gamebot
REDIS_URL=redis://redis:6379/0
POSTGRES_PASSWORD=gamebot

# ---------------------------------------------------------------- تلگرام
# توکن ربات از @BotFather
BOT_TOKEN=123456:ABC-DEF
# یوزرنیم ربات بدون @ (اگر خالی باشد از تلگرام خوانده می‌شود)
BOT_USERNAME=
# آیدی عددی سوپرادمین‌ها، با ویرگول
SUPERADMIN_IDS=111111111,222222222

# خالی = polling (توسعه). برای production آدرس عمومی HTTPS را بدهید (webhook)
WEBHOOK_URL=
WEBHOOK_SECRET=change-me-random
WEBHOOK_PORT=8443

# دکمه‌های رنگی اینلاین (آبی/سبز/قرمز). اگر کلاینتی مشکل داشت False کنید تا دکمه‌ها ساده شوند.
BUTTON_STYLES=True
# چند به‌روزرسانی هم‌زمان پردازش شود؛ ترتیب پیام‌های هر چت همیشه حفظ می‌شود (۱ = یکی‌یکی)
BOT_CONCURRENT_UPDATES=32

# ---------------------------------------------------------------- مینی‌اپ آرکید
# نام کوتاهی که در BotFather با /newapp ثبت کرده‌اید
MINIAPP_SHORT_NAME=arcade
# آدرس عمومی HTTPS سرویس web (برای دکمه‌ی تمرین آزاد در پیوی)
MINIAPP_BASE_URL=https://example.com

# فقط توسعه‌ی محلی: باز کردن صفحه‌ی بازی در مرورگر بدون تلگرام (نیاز به DEBUG=True). هرگز در production روشن نکنید.
ARCADE_DEV_AUTH=False

LOG_LEVEL=INFO
